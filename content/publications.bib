@inproceedings{huang2022modulation,
  selected={true},
  title = {Low-SNR Modulation Recognition Method Based on Time-Frequency Analysis and SVM},
  author = {Xinyi Huang},
  year = {2022},
  month = mar,
  booktitle = {IEEE Conference on EEBDA},
  abstract = {This paper proposes a modulation recognition method combining time-frequency analysis with a support vector machine (SVM) classifier. Time-domain, frequency-domain, and wavelet energy entropy features are extracted to identify FSK, FM, and AM signal types. At a signal-to-noise ratio of 15 dB, the average recognition rate reaches 95%; at 30 dB, the recognition rate reaches 98.6%. The proposed method features low complexity and outperforms decision-tree-based approaches, making it well suited for engineering applications.},
  description = {A time-frequency analysis and SVM-based approach for low-SNR modulation recognition of FSK, FM, and AM signals with 98.6% accuracy at 30 dB SNR.},
  keywords = {Modulation Recognition, Time-Frequency Analysis, SVM, Signal Processing}
}
